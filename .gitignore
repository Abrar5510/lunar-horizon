# Large or re-downloadable data (see docs/03 and tools/fetch_and_prep.sh)
/dem/*
!/dem/urls.txt
/dem_ready/
/sites/
/kernels/
/plugins/
/installers/
/cspice/
/ue_cache/
/.venv/
# Unreal caches (real dirs: dylib rpaths and UBA break through symlinks)
/LunarHorizon/Binaries
/LunarHorizon/DerivedDataCache
/LunarHorizon/Intermediate
/LunarHorizon/Saved
.DS_Store
__pycache__/
# Machine-local: Cesium plugin symlink, Zen cache path, pj project tracker
/LunarHorizon/Plugins/CesiumForUnreal
/LunarHorizon/Config/Mac/MacEngine.ini
/STATE.md
# MarsMap: Unreal caches, machine-local Zen path, MOLA grids (tools/mars_prep.py downloads them)
/MarsMap/Binaries
/MarsMap/DerivedDataCache
/MarsMap/Intermediate
/MarsMap/Saved
/MarsMap/Config/Mac/MacEngine.ini
/MarsMap/Content/Data/*.img
/LunarHorizon/cesium-request-cache.sqlite
